# Local settings, copy to config.env. On GitHub Actions these come from the
# workflow inputs and repository secrets instead.

TELEGRAM_TOKEN=
# one or more targets, separated by commas or spaces:
#   123456789  -1001234567890  @channelname  -1001234567890/42 (forum topic)
TELEGRAM_CHAT=

CODENAME=
LTO=full
CLEAN=n
#JOBS=8

#KERNEL_REPO=https://github.com/itelrs4/kernel_common-5.10
#KERNEL_BRANCH=android12-5.10-staging
#KERNEL_DIR=/path/to/kernel

# private KernelSU-Next and SUSFS patches
#SUSFS_DIR=/path/to/susfs-patches
